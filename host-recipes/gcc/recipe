#!/bin/sh

revision=1
from_source=gcc
imagedeps="gcc build-essential pkg-config libgmp-dev libmpfr-dev libmpc-dev flex texinfo bison libisl-dev gettext"
deps="mlibc-headers"
hostdeps="binutils"

configure() {
    # Each build directory supplies libc for one architecture.
    ${source_dir}/configure --target=${JINX_ARCH}-pmos --with-sysroot="${sysroot}" --with-gxx-include-dir="${sysroot}/usr/include/c++" --enable-languages=c,c++ --disable-multilib
}

build() {
    make -j ${parallelism} all-gcc all-target-libgcc
}

package() {
    make DESTDIR="${dest_dir}" install-gcc install-target-libgcc
}