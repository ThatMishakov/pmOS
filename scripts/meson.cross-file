[binaries]
c = '$C_COMPILER'
cpp = '$CXX_COMPILER'
ar = '$TOOLS_PREFIX-ar'
nm = '$TOOLS_PREFIX-nm'
objcopy = '$TOOLS_PREFIX-objcopy'
ranlib = '$TOOLS_PREFIX-ranlib'
strip = '$TOOLS_PREFIX-strip'
pkg-config = 'pkg-config'
llvm-config = '/base_dir/support/llvm-config'

[host_machine]
system = 'pmos'
cpu_family = '${CPU_FAMILY}'
cpu = '${JINX_ARCH}'
endian = '${ENDIAN}'

[built-in options]
libdir = 'lib'
c_args = [${MESON_TARGET_ARGS}'--sysroot=${sysroot}']
cpp_args = [${MESON_TARGET_ARGS}'--sysroot=${sysroot}']
c_link_args = [${MESON_TARGET_ARGS}'--sysroot=${sysroot}']
cpp_link_args = [${MESON_TARGET_ARGS}'--sysroot=${sysroot}']

[properties]
sys_root = '${sysroot}'
pkg_config_libdir = ['${sysroot}/usr/lib/pkgconfig', '${sysroot}/usr/share/pkgconfig']