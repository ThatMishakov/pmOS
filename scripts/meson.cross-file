[binaries]
c = '$C_COMPILER'
cpp = '$CXX_COMPILER'
ar = '$TOOLS_PREFIX-ar'
nm = '$TOOLS_PREFIX-nm'
objcopy = '$TOOLS_PREFIX-objcopy'
ranlib = '$TOOLS_PREFIX-ranlib'
strip = '$TOOLS_PREFIX-strip'
pkg-config = 'pkg-config'

[host_machine]
system = 'pmos'
cpu_family = '${CPU_FAMILY}'
cpu = '${PMOS_ARCH}'
endian = '${ENDIAN}'

[built-in options]
libdir = 'lib'
c_args = [${MESON_TARGET_ARGS}'--sysroot=${SYSROOT_DIR}']
cpp_args = [${MESON_TARGET_ARGS}'--sysroot=${SYSROOT_DIR}']
c_link_args = [${MESON_TARGET_ARGS}'--sysroot=${SYSROOT_DIR}']
cpp_link_args = [${MESON_TARGET_ARGS}'--sysroot=${SYSROOT_DIR}']

[properties]
sys_root = '${SYSROOT_DIR}'
pkg_config_libdir = ['${SYSROOT_DIR}/usr/lib/pkgconfig', '${SYSROOT_DIR}/usr/share/pkgconfig']
