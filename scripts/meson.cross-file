[binaries]
c = 'clang'
cpp = 'clang++'
ar = 'llvm-ar'
nm = 'llvm-nm'
objcopy = 'llvm-objcopy'
ranlib = 'llvm-ranlib'
strip = 'llvm-strip'
pkg-config = 'llvm-pkg-config'
llvm-config = '/base_dir/support/llvm-config'

[host_machine]
system = 'pmos'
cpu_family = '${CPU_FAMILY}'
cpu = '${JINX_ARCH}'
endian = 'little'

[built-in options]
libdir = 'lib'
c_args = ['--target=${JINX_ARCH}-pmos', '--sysroot=${sysroot}']
cpp_args = ['--target=${JINX_ARCH}-pmos', '--sysroot=${sysroot}']
c_link_args = ['--target=${JINX_ARCH}-pmos', '--sysroot=${sysroot}']
cpp_link_args = ['--target=${JINX_ARCH}-pmos', '--sysroot=${sysroot}']