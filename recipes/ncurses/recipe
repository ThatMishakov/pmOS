
version=6.5
revision=1
source_method=tarball
tarball_url="https://ftp.gnu.org/gnu/ncurses/ncurses-6.5.tar.gz"
tarball_sha256="136d91bc269a9a5785e5f9e980bc76ab57428f604ce3e5a5a90cebc767971cc6"

imagedeps="build-essential"
deps="mlibc $CXX_DEPS"
hostdeps="$TOOLCHAIN_DEPS"

configure() {
	CC="clang --target=${JINX_ARCH}-unknown-pmos --sysroot=${sysroot}" \
	CXX="clang++ --target=${JINX_ARCH}-unknown-pmos --sysroot=${sysroot}" \
	CPP="clang --target=${JINX_ARCH}-unknown-pmos --sysroot=${sysroot} -E" \
	CPPFLAGS="-D_GNU_SOURCE" \
	${source_dir}/configure --build=$(uname -m)-pc-linux-gnu --host=$JINX_ARCH-pmos --prefix=${prefix} --with-shared --without-normal --with-termlib --enable-pc-files --enable-widec \
		--with-build-cc=gcc \
		--with-build-cpp='gcc -E'
}

build() {
	make -j${parallelism}
}

package() {
	# ncurses hardcodes a bare `install -s` (INSTALL_OPT_S), which would strip the
	# x86_64 target binaries with the host's native strip and fail on non-x86_64
	# hosts. Point install at the cross strip so the binaries are still stripped.
	make install DESTDIR="${dest_dir}" INSTALL_PROG='$(INSTALL) -s --strip-program=llvm-strip'

	echo "INPUT(-lncursesw)" > ${dest_dir}${prefix}/lib/libncurses.so
	echo "INPUT(-ltinfow)" > ${dest_dir}${prefix}/lib/libtinfo.so
	echo "INPUT(-lmenuw)" > ${dest_dir}${prefix}/lib/libmenu.so
	echo "INPUT(-lformw)" > ${dest_dir}${prefix}/lib/libform.so
	echo "INPUT(-lpanelw)" > ${dest_dir}${prefix}/lib/libpanel.so
	echo "INPUT(-lncursesw)" > ${dest_dir}${prefix}/lib/libcursesw.so
	cp ${dest_dir}${prefix}/lib/libncurses.so ${dest_dir}${prefix}/lib/libcurses.so
}