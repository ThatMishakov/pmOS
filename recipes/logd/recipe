#!/bin/sh

version=0.0.1
revision=1

source_dir=userspace/logd
deps="mlibc mlibc-headers pmoscxx"
hostdeps="$TOOLCHAIN_DEPS $CXX_DEPS"

configure() {
    cmake_configure
}

build() {
    make -j ${parallelism}
}

package() {
    DESTDIR="${dest_dir}" make install
    cp ${source_dir}/logd.yaml "${dest_dir}/boot/logd.yaml"
}